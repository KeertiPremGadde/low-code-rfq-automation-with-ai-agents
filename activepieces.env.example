# Template for activepieces.env. Run scripts/init_env.py to create activepieces.env
# with random secrets. Never commit activepieces.env.

AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js
AP_API_KEY=__RANDOM_HEX_64__
AP_ENCRYPTION_KEY=__RANDOM_HEX_16__
AP_JWT_SECRET=__RANDOM_HEX_32__
AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8080
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=ap-postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=__DB_PASSWORD__
AP_EXECUTION_MODE=UNSANDBOXED
AP_REDIS_HOST=ap-redis
AP_REDIS_PORT=6379
AP_FLOW_TIMEOUT_SECONDS=600
AP_TELEMETRY_ENABLED=false
AP_TEMPLATES_SOURCE_URL=https://cloud.activepieces.com/api/v1/flow-templates

# Used by the ap-postgres container (same values as above)
POSTGRES_DB=activepieces
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__DB_PASSWORD__

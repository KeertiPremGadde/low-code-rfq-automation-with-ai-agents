# Copy to .env (scripts/init_env.py does this for you). Never commit .env.

# --- Model ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
LLM_PROVIDER=anthropic            # anthropic | ollama
LLM_EXTRACT_MODEL=claude-haiku-5-5
LLM_AGENT_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
PROMPT_VERSION=extract-v1

# --- Local services (as seen from Windows) ---
MAILPIT_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
BASEROW_URL=http://localhost:8081
# Baserow admin login used by scripts/setup_baserow.py. The first run registers this account,
# so choose your own password. Local use only; never commit .env.
BASEROW_ADMIN_EMAIL=admin@biddesk.example
BASEROW_ADMIN_PASSWORD=CHANGE_ME_choose_a_password
BASEROW_TOKEN=                    # printed by scripts/setup_baserow.py
BASEROW_RFQS_TABLE_ID=            # printed by scripts/setup_baserow.py
BASEROW_PASTBIDS_TABLE_ID=        # printed by scripts/setup_baserow.py

# --- Mailpit -> Activepieces webhook (set after publishing the flow) ---
# e.g. http://activepieces:80/api/v1/webhooks/<flowId>
MP_WEBHOOK_URL=
